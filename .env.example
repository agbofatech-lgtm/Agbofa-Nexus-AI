# Agbofa Nexus AI — process configuration template (PROD-00)
# Copy to a runtime-local .env that is NEVER committed.
# Values below are placeholders. Do not paste production secrets into Arena.

AGBOFA_ENV=development
AGBOFA_SERVICE_NAME=foundation
AGBOFA_SECRET_PROVIDER=env
# AGBOFA_SECRET_PROVIDER=file
# AGBOFA_SECRET_FILE_DIR=/run/secrets
# Reserved (fail closed until wired): aws_secrets_manager | vault

AGBOFA_HTTP_ADDR=:8080
AGBOFA_GRPC_ADDR=:9090

# Secret names are resolved by the provider. For provider=env the process
# variables are AGBOFA_SECRET_<NORMALIZED_NAME>.
AGBOFA_DATABASE_URL_SECRET=database/url
AGBOFA_SECRET_DATABASE_URL=postgres://nexus:CHANGE_ME@127.0.0.1:5432/nexus?sslmode=disable
# Integration tests only. Never a production database.
AGBOFA_TEST_DATABASE_URL=postgres://nexus:CHANGE_ME@127.0.0.1:5432/nexus_test?sslmode=disable
AGBOFA_DATABASE_MAX_CONNS=10
AGBOFA_DATABASE_MIN_CONNS=1
AGBOFA_DATABASE_QUERY_TIMEOUT=5s

AGBOFA_JWT_ISSUER=https://auth.example.invalid
AGBOFA_JWT_AUDIENCE=agbofa-nexus-ai
AGBOFA_JWT_ALGORITHM=RS256
AGBOFA_JWT_ACCESS_TTL=15m
AGBOFA_JWT_REFRESH_TTL=720h
AGBOFA_JWT_ACTIVE_KID=k1
AGBOFA_JWT_KEYS=k1
AGBOFA_JWT_KEY_K1_USE=sign
# Optional rotation window (RFC3339). Omitted means unbounded.
# AGBOFA_JWT_KEY_K1_NOT_BEFORE=2026-01-01T00:00:00Z
# AGBOFA_JWT_KEY_K1_NOT_AFTER=2027-01-01T00:00:00Z
AGBOFA_SECRET_JWT_KEYS_K1_PRIVATE_PEM=
AGBOFA_SECRET_JWT_KEYS_K1_PUBLIC_PEM=

AGBOFA_COOKIE_NAME=agbofa_session
AGBOFA_COOKIE_SECURE=true
AGBOFA_COOKIE_HTTPONLY=true
AGBOFA_COOKIE_SAMESITE=Lax
AGBOFA_COOKIE_PATH=/
AGBOFA_COOKIE_DOMAIN=
AGBOFA_COOKIE_MAX_AGE=720h

AGBOFA_CSRF_COOKIE_NAME=agbofa_csrf
AGBOFA_CSRF_HEADER_NAME=X-CSRF-Token
AGBOFA_CORS_ALLOWED_ORIGINS=https://app.example.invalid

# Phase 02 AI providers — server-side only. Never send these to the browser.
# Leave empty to fail closed (no fabricated completions).
AGBOFA_OPENAI_BASE_URL=https://api.openai.com/v1
AGBOFA_ANTHROPIC_BASE_URL=https://api.anthropic.com
AGBOFA_AI_TIMEOUT=30s
AGBOFA_SECRET_AI_OPENAI_API_KEY=
AGBOFA_SECRET_AI_ANTHROPIC_API_KEY=
