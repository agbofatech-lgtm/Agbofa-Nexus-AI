# Environment Configuration Example — IMP-017-A AI Agent Fleet (Platform Monitors)
SERVICE_NAME=agbofa-agents
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# --- SERVICE PORTS ---
GRPC_PORT=9090
HTTP_PORT=9091
METRICS_PORT=9092

# --- UPSTREAM SERVICE DEPENDENCIES ---
RUNTIME_GRPC_ENDPOINT=localhost:9090
FOUNDATION_GRPC_ENDPOINT=localhost:9090

# --- DATABASE & RLS CONFIGURATION ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agbofa_nexus?sslmode=disable
RLS_APP_CURRENT_TENANT=00000000-0000-0000-0000-000000000000

# --- EVENT BUS (KAFKA) ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=agbofa.nexus.p2.agents.

# --- PLATFORM API SECRETS (MONITORS AGT-001 TO AGT-008) ---
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
INSTAGRAM_GRAPH_API_KEY=your_instagram_graph_api_key
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
YOUTUBE_API_KEY=your_youtube_api_key
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
