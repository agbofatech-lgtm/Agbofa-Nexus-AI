{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agbofa.local/content_origination/v1/origination-event.schema.json",
  "title": "ContentOriginationEvent",
  "description": "Schema for EVT-019 (truth_engine.story.submitted) and EVT-039 (content_origination.events) produced by SVC-030 and Content Origination services.",
  "type": "object",
  "required": ["event_id", "event_type", "tenant_id", "story_id", "state", "occurred_at"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "content_origination.ingested",
        "content_origination.story_detected",
        "content_origination.story_state_changed",
        "content_origination.graph_node_initialized",
        "truth_engine.story.submitted"
      ]
    },
    "tenant_id": { "type": "string" },
    "story_id": { "type": "string" },
    "source_id": { "type": "string" },
    "candidate_id": { "type": "string" },
    "state": {
      "type": "string",
      "enum": ["INGESTED", "DETECTED", "IDEA_GENERATED", "PITCHED", "SUBMITTED_FOR_VERIFICATION"]
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
