{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agbofa.local/runtime/v1/workflow-runtime-event.schema.json",
  "title": "WorkflowRuntimeEvent",
  "description": "Schema for EVT-045 Workflow Runtime Events produced by SVC-143 and consumed by SVC-145/SVC-146.",
  "type": "object",
  "required": ["event_id", "event_type", "tenant_id", "workflow_id", "execution_id", "status", "occurred_at"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "workflow.runtime.started",
        "workflow.runtime.step_completed",
        "workflow.runtime.completed",
        "workflow.runtime.failed",
        "workflow.runtime.cancelled"
      ]
    },
    "tenant_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "execution_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["STARTED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED"]
    },
    "step_name": { "type": "string" },
    "duration_ms": { "type": "integer" },
    "tokens_used": { "type": "integer" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
