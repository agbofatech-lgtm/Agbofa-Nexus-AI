{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agbofa.local/compliance/v1/compliance-event.schema.json",
  "title": "ComplianceGatekeeperEvent",
  "description": "Schema for EVT-025 consumer and compliance producer events in Compliance Gatekeeper.",
  "type": "object",
  "required": ["event_id", "event_type", "tenant_id", "package_id", "occurred_at"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": [
        "truth_engine.misinfo.detected",
        "compliance.policy.evaluated",
        "compliance.review.required",
        "compliance.package.approved",
        "compliance.package.rejected"
      ]
    },
    "tenant_id": { "type": "string" },
    "package_id": { "type": "string" },
    "story_id": { "type": "string" },
    "report_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["COMPLIANT", "REVIEW_REQUIRED", "REJECTED"]
    },
    "overall_score": { "type": "number" },
    "misinfo_flagged": { "type": "boolean" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
